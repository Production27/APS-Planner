{
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --outfile=dist/app.bundle.js --format=iife --jsx=automatic --jsx-import-source=preact",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "cd worker && npx wrangler types && npx tsc --noEmit",
    "test": "playwright test --config=tests/playwright.config.js",
    "test:worker": "node --test worker/src/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "preact": "10.29.8",
    "qrcode-generator": "2.0.4",
    "reconnecting-websocket": "4.4.0"
  }
}
